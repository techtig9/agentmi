# Agentmi environment
#
# Every variable is marked [required] or [optional].
# The app builds and the public pages render with NONE of these set; feature
# routes answer 503 "not configured" and /setup lists what is missing.
# Copy to .env.local for development. Never commit a filled-in copy.

# ---------------------------------------------------------------------------
# Supabase — database, auth and storage
# ---------------------------------------------------------------------------
# [required] Project URL, Supabase > Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
# [required] Anon/publishable key. Safe in the browser; RLS constrains it.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [required] Service-role key. Server-only: bypasses RLS, never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# App identity
# ---------------------------------------------------------------------------
# [required] Public origin of this deployment. Used to build the endpoint URLs
# shown on the Deployments page and in emails. No trailing slash.
NEXT_PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# AI providers — tried in cost order, falling through on quota/capacity errors.
# At least ONE is required before any agent can run.
# ---------------------------------------------------------------------------
# [optional] First choice. console.groq.com
GROQ_API_KEY=
# [optional] Model id for Groq.
GROQ_MODEL=llama-3.3-70b-versatile
# [optional] Second choice. cloud.cerebras.ai
CEREBRAS_API_KEY=
# [optional] Model id for Cerebras.
CEREBRAS_MODEL=llama-3.3-70b
# [optional] Third choice, widest model catalogue. openrouter.ai
OPENROUTER_API_KEY=
# [optional] Model id for OpenRouter.
OPENROUTER_MODEL=openai/gpt-4o-mini
# [optional] Attribution headers OpenRouter shows on your account dashboard.
OPENROUTER_SITE_URL=
# [optional] Application name sent with OpenRouter attribution headers.
OPENROUTER_APP_NAME=Agentmi

# [optional] Escalation provider for long or complex prompts. Off unless true.
ANTHROPIC_ENABLED=false
# [optional] Required only when ANTHROPIC_ENABLED=true.
ANTHROPIC_API_KEY=
# [optional] Model id used for escalated requests.
ANTHROPIC_MODEL=claude-sonnet-5
# [optional] Prompt length in characters above which a request counts as complex.
AI_COMPLEXITY_CHARS=5000
# [optional] Send every request to Anthropic regardless of complexity. Debug only.
AI_FORCE_ANTHROPIC=false

# ---------------------------------------------------------------------------
# Embeddings — gates Knowledge indexing and retrieval only
# ---------------------------------------------------------------------------
# [optional] Set false to disable Knowledge entirely.
VOYAGE_ENABLED=true
# [optional] voyageai.com. Without it, Knowledge indexing is unavailable and
# the rest of the product is unaffected.
VOYAGE_API_KEY=
# [optional] Embedding model id.
VOYAGE_EMBEDDING_MODEL=voyage-2

# ---------------------------------------------------------------------------
# Paddle — billing. Without these, plans display but checkout is unavailable.
# ---------------------------------------------------------------------------
# [optional] Server-side API key. Paddle > Developer Tools > Authentication.
PADDLE_API_KEY=
# [optional] Signing secret for the webhook endpoint. Deliveries are rejected
# without it, so a payment would never update a subscription.
PADDLE_WEBHOOK_SECRET=
# [optional] Client-side token for Paddle.js checkout.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# [optional] One Paddle Price id per plan and cycle. On each Price set Custom
# Data to {"plan_id":"starter"} (or "pro" / "business") — the webhook reads it
# to decide which plan was purchased.
# [optional] Starter, billed monthly.
PADDLE_PRICE_STARTER_MONTHLY=
# [optional] Starter, billed yearly.
PADDLE_PRICE_STARTER_YEARLY=
# [optional] Pro, billed monthly.
PADDLE_PRICE_PRO_MONTHLY=
# [optional] Pro, billed yearly.
PADDLE_PRICE_PRO_YEARLY=
# [optional] Business, billed monthly.
PADDLE_PRICE_BUSINESS_MONTHLY=
# [optional] Business, billed yearly.
PADDLE_PRICE_BUSINESS_YEARLY=

# ---------------------------------------------------------------------------
# Launch pricing
# ---------------------------------------------------------------------------
# [optional] Show promotional launch pricing on the marketing page.
LAUNCH_PRICING_ENABLED=false
# [optional] ISO 8601 instant the promotion ends.
LAUNCH_PRICING_ENDS_AT=2026-09-30T00:00:00Z

# ---------------------------------------------------------------------------
# ML training service (Python, deployed separately)
# ---------------------------------------------------------------------------
# [optional] Base URL of the training service. ML agent training and
# prediction are unavailable without it; AI agents are unaffected.
TRAINING_SERVICE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Observability (both entirely optional; absent means the wrappers no-op)
# ---------------------------------------------------------------------------
# [optional] Error-reporting DSN. Without it, errors are still written as
# structured JSON log lines rather than swallowed.
SENTRY_DSN=
# [optional] Product analytics id. Without it, trackEvent() drops events.
NEXT_PUBLIC_ANALYTICS_ID=
