# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cost-first AI provider chain (connect these first)
# 1) Groq -> 2) Cerebras -> 3) OpenRouter
# If the active provider returns a quota/rate-limit/temporary-capacity error,
# Agentmi automatically tries the next configured provider.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Agentmi

# Optional premium reasoning provider.
# For complex/large tasks, Agentmi prefers Anthropic when this key exists.
# Leave blank now; add it later when you subscribe/connect billing.
ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
AI_COMPLEXITY_CHARS=5000
AI_FORCE_ANTHROPIC=false

# Optional Voyage AI embeddings for Knowledge/RAG.
# Voyage is NOT a chat/agent model. Leave blank if you do not want to pay for it yet.
# When configured, Knowledge/RAG indexing and retrieval are enabled.
VOYAGE_ENABLED=false
VOYAGE_API_KEY=
VOYAGE_EMBEDDING_MODEL=voyage-2

# Paddle Billing (optional until billing is configured)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_STARTER_MONTHLY=
PADDLE_PRICE_STARTER_YEARLY=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_YEARLY=
PADDLE_PRICE_BUSINESS_MONTHLY=
PADDLE_PRICE_BUSINESS_YEARLY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
LAUNCH_PRICING_ENABLED=true
LAUNCH_PRICING_ENDS_AT=2026-09-30T00:00:00Z

# ML Training microservice
TRAINING_SERVICE_URL=http://localhost:8000
